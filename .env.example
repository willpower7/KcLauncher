# ==============================================================================
# KcLauncher Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.

# Enable verbose diagnostic logging to stdout
KEYCHRON_DEBUG=0

# Open Chromium Developer Tools automatically on application launch
KEYCHRON_DEVTOOLS=0

# Force offline diagnostic fallback mode
KEYCHRON_OFFLINE=0

# Run using locally mirrored launcher assets instead of remote web application
KEYCHRON_LOCAL_MIRROR=0
