{
  "name": "kclauncher",
  "version": "1.0.2",
  "description": "Native Linux desktop application port of Keychron Launcher with WebHID support and automated udev configuration",
  "main": "src/main/index.js",
  "type": "commonjs",
  "author": "William Johnson <willpower7>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willpower7/KcLauncher.git"
  },
  "keywords": [
    "keychron",
    "launcher",
    "webhid",
    "linux",
    "debian",
    "deb",
    "qmk",
    "via",
    "keyboard",
    "mouse"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "KEYCHRON_DEBUG=1 KEYCHRON_DEVTOOLS=1 electron .",
    "test": "node scripts/test-suite.js",
    "build:deb": "electron-builder --linux deb --config build/electron-builder.yml --publish never",
    "build:appimage": "electron-builder --linux AppImage --config build/electron-builder.yml --publish never",
    "build:all": "electron-builder --linux deb AppImage --config build/electron-builder.yml --publish never",
    "pack": "electron-builder --dir --config build/electron-builder.yml",
    "mirror:assets": "node scripts/mirror-offline-assets.js",
    "generate:apt": "bash scripts/generate-apt-repo.sh",
    "install:udev": "bash scripts/install-udev.sh",
    "verify:udev": "bash scripts/verify-udev.sh"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "builder-util-runtime": "^9.7.0"
  }
}
