#!/bin/sh
set -e

# KcLauncher Debian post-installation script
# Reloads udev rules so Keychron USB/WebHID devices are accessible without reboot

if [ "$1" = "configure" ]; then
    # Install udev rule to system directory
    if [ -f "/opt/Keychron Launcher/lib/udev/rules.d/60-keychron.rules" ]; then
        mkdir -p /lib/udev/rules.d
        cp "/opt/Keychron Launcher/lib/udev/rules.d/60-keychron.rules" /lib/udev/rules.d/60-keychron.rules
        chmod 644 /lib/udev/rules.d/60-keychron.rules
    fi

    # Install AppStream metainfo
    if [ -f "/opt/Keychron Launcher/usr/share/metainfo/com.willpower7.kclauncher.metainfo.xml" ]; then
        mkdir -p /usr/share/metainfo
        cp "/opt/Keychron Launcher/usr/share/metainfo/com.willpower7.kclauncher.metainfo.xml" /usr/share/metainfo/com.willpower7.kclauncher.metainfo.xml
        chmod 644 /usr/share/metainfo/com.willpower7.kclauncher.metainfo.xml
    fi

    # Reload udev daemon if running
    if [ -x /bin/udevadm ] || [ -x /usr/bin/udevadm ]; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=hidraw || true
        udevadm trigger --subsystem-match=usb || true
    fi

    # Create symlink in /usr/bin
    if [ -f "/opt/Keychron Launcher/kclauncher" ]; then
        ln -sf "/opt/Keychron Launcher/kclauncher" /usr/bin/kclauncher
    fi

    # Update desktop database
    if [ -x /usr/bin/update-desktop-database ]; then
        update-desktop-database -q /usr/share/applications || true
    fi
fi

exit 0
