#!/bin/sh
set -e

# KcLauncher Debian post-removal script

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # Remove system udev rule, symlink, and metainfo
    rm -f /lib/udev/rules.d/60-keychron.rules
    rm -f /usr/bin/kclauncher
    rm -f /usr/share/metainfo/com.willpower7.kclauncher.metainfo.xml

    if [ -x /bin/udevadm ] || [ -x /usr/bin/udevadm ]; then
        udevadm control --reload-rules || true
        udevadm trigger || true
    fi

    if [ -x /usr/bin/update-desktop-database ]; then
        update-desktop-database -q /usr/share/applications || true
    fi
fi

exit 0
